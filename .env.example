# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: signs 90-second kiosk sessions (derived from SUPABASE_SECRET_KEY when unset)
KIOSK_SESSION_SECRET=

# Scripts only (CLI, Management API, Vercel API)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Email via Resend (edge function secrets; RESEND_FROM needs a verified domain)
RESEND_API_KEY=
RESEND_FROM=
